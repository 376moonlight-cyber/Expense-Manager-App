# -----------------------------------------------------------------------------
# Database (SQLite — local development)
# -----------------------------------------------------------------------------
# Relative to the prisma/ directory. Creates prisma/dev.db on first migrate.
DATABASE_URL="file:./dev.db"

# -----------------------------------------------------------------------------
# Auth.js / NextAuth
# -----------------------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_TRUST_HOST="true"
# Optional: set explicitly to your app origin
# AUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Receipt storage
# -----------------------------------------------------------------------------
# Receipts are saved under ./uploads/ (gitignored). No cloud storage env vars
# are required for local development.

# -----------------------------------------------------------------------------
# Optional seed behavior
# -----------------------------------------------------------------------------
# Set to false if you do not want the demo login created
# SEED_DEMO_USER="false"

# -----------------------------------------------------------------------------
# Support / contact (About page)
# -----------------------------------------------------------------------------
# Shown as a mailto link on /about. Falls back to support@example.com if unset.
# NEXT_PUBLIC_SUPPORT_EMAIL="you@example.com"
# Developer credit shown on About and in the app footer. Falls back to Ayesha Ali.
# NEXT_PUBLIC_DEVELOPER_NAME="Ayesha Ali"
