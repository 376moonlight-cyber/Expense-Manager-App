# -----------------------------------------------------------------------------
# Database (PostgreSQL — Neon)
# -----------------------------------------------------------------------------
# Pooled connection for the app / Prisma Client (hostname usually includes -pooler).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooled) connection for Prisma Migrate / introspection.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# -----------------------------------------------------------------------------
# Auth.js / NextAuth
# -----------------------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-secret"
# Trust the Host header on Vercel (also set trustHost in auth.config.ts).
AUTH_TRUST_HOST="true"
# Canonical site URL (use your https://….vercel.app or custom domain in production).
# AUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Receipt storage (Vercel Blob — private)
# -----------------------------------------------------------------------------
# Create a private Blob store in the Vercel dashboard (Storage → Blob → Private)
# and connect it to the project. Add the read-write token for local/dev and when
# OIDC is not available. On Vercel, connected stores can also use OIDC.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_…"

# -----------------------------------------------------------------------------
# Optional seed behavior
# -----------------------------------------------------------------------------
# Demo user is never seeded in production. Locally it is created unless you set:
# SEED_DEMO_USER="false"
# The Vercel build does not run prisma db seed.

# -----------------------------------------------------------------------------
# Support / contact (About page)
# -----------------------------------------------------------------------------
# Shown as a mailto link on /about. Falls back to support@example.com if unset.
# NEXT_PUBLIC_SUPPORT_EMAIL="you@example.com"
# Developer credit shown on About and in the app footer. Falls back to Ayesha Ali.
# NEXT_PUBLIC_DEVELOPER_NAME="Ayesha Ali"
